generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model GuildConfig {
  id                 String   @id @default(cuid())
  guildId            String   @unique
  modLogChannelId    String?  // channel to log moderation actions
  welcomeEnabled     Boolean  @default(false)
  welcomeChannelId   String?
  welcomeMessage     String?
  goodbyeEnabled     Boolean  @default(false)
  goodbyeChannelId   String?
  musicDefaultVolume Int      @default(50)
  musicIdleMinutes   Int      @default(5)
  musicAutoplay      Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Reminder {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  text      String
  dueAt     DateTime
  createdAt DateTime @default(now())
  completed Boolean  @default(false)
}

model ReactionRole {
  id          String   @id @default(cuid())
  guildId     String
  messageId   String
  channelId   String
  emoji       String
  roleId      String
  createdAt   DateTime @default(now())
}

model AnimeAlert {
  id            String   @id @default(cuid())
  guildId       String
  channelId     String
  userId        String   // Added for user-specific alerts
  animeId       String   // MyAnimeList ID or name
  animeName     String   // Renamed from animeName
  title         String   @default("") // Display title
  lastEpisode   Int      @default(0)
  createdAt     DateTime @default(now())
  
  @@unique([guildId, animeId])
  @@index([userId])
}

model User {
  id                    String   @id @default(cuid())
  userId                String   @unique  // Discord user ID
  balance               Int      @default(0)  // Wallet balance
  bank                  Int      @default(0)  // Bank balance
  linkedRolesVerified   Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model UserEconomy {
  id            String   @id @default(cuid())
  userId        String   @unique  // Global per user, not per guild
  coins         Int      @default(0)
  level         Int      @default(1)
  xp            Int      @default(0)
  lastDaily     DateTime?
  lastRep       DateTime?
  totalWagered  Int      @default(0)  // Total amount wagered
  totalWon      Int      @default(0)   // Total amount won
  gamesPlayed   Int      @default(0)   // Total games played
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StreamAlert {
  id            String   @id @default(cuid())
  guildId       String
  channelId     String
  platform      String   // "youtube" or "twitch"
  streamerId    String   // Channel ID or username
  streamerName  String
  lastNotified  DateTime?
  createdAt     DateTime @default(now())
  
  @@unique([guildId, platform, streamerId])
}

model UserInventory {
  id        String   @id @default(cuid())
  userId    String
  itemId    String   // Item identifier (e.g., "bg_sunset", "badge_winner")
  itemType  String   // "background", "badge", "color"
  itemName  String
  equipped  Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@unique([userId, itemId])
  @@index([userId])
}


