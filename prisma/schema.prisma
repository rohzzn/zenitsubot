generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// What Zenitsu knows about one person in voice.
///
/// Keyed on the Discord user id, which the voice receiver hands over with every
/// audio stream — so a speaker is identified before a word is transcribed, and
/// the right memory is loaded before the model is asked anything.
model VoiceProfile {
  userId      String  @id
  /// What they like to be called, when it differs from their Discord name.
  displayName String?
  /// Free-form preferences the model wrote about how to talk to them.
  preferences String?

  /// Rolling summary of past conversations, rewritten rather than appended.
  summary String?

  firstHeardAt DateTime  @default(now())
  lastHeardAt  DateTime  @default(now())
  turns        Int       @default(0)

  facts     VoiceFact[]
  exchanges VoiceExchange[]

  @@index([lastHeardAt])
}

/// One thing worth remembering about someone.
///
/// Separate rows rather than a blob so a single fact can be corrected or
/// forgotten without rewriting everything else the bot knows about a person.
model VoiceFact {
  id     String @id @default(cuid())
  userId String
  /// Short subject, so a later fact about the same thing can replace it.
  topic  String
  fact   String

  /// Set when the model itself recorded this, rather than the user asking.
  inferred  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile VoiceProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, topic])
  @@index([userId, updatedAt])
}

/// Recent turns, kept briefly so "what did I just say" works across sessions.
model VoiceExchange {
  id     String @id @default(cuid())
  userId String

  spoke    String
  answered String?
  guildId  String?
  at       DateTime @default(now())

  profile VoiceProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, at])
}

/// Backing state for message components.
///
/// A collector only exists inside the running process, so every button in a
/// message went dead the moment the bot restarted. Keying the state to the
/// message id instead means a button works for as long as the row lives,
/// across any number of deploys.
model ComponentState {
  messageId String   @id
  kind      String // which command owns this message
  ownerId   String // who may operate the controls
  payload   String // JSON; shape is the owning command's business
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// One person's subscription to one feed.
///
/// Per-user rather than per-channel: the delivery people actually want is a
/// DM, and a feed two people follow should be polled once, not twice — hence
/// the shared FeedSource below holding everything about the feed itself.
model FeedSubscription {
  id       String @id @default(cuid())
  userId   String
  sourceId String

  /// Overrides the feed's own title in listings, when someone renames it.
  label String?

  /// digest | instant | manual
  mode       String  @default("digest")
  /// Hour of the day, UTC, that a digest is sent.
  digestHour Int     @default(9)
  /// Comma-separated words; an item must contain one of these to be sent.
  include    String?
  /// Comma-separated words; an item containing any of these is never sent.
  exclude    String?
  paused     Boolean @default(false)
  /// Set when delivery failed because the user's DMs are closed.
  pauseNote  String?

  createdAt   DateTime  @default(now())
  lastSentAt  DateTime?
  deliveredCount Int    @default(0)

  source FeedSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  reads  FeedDelivery[]

  @@unique([userId, sourceId])
  @@index([mode, paused])
}

/// A feed, independent of who follows it. Polled once for everyone.
model FeedSource {
  id      String  @id @default(cuid())
  url     String  @unique
  title   String
  siteUrl String?
  iconUrl String?

  /// Conditional-request headers, so an unchanged feed costs a 304.
  etag         String?
  lastModified String?

  lastCheckedAt DateTime?
  /// Consecutive failures; drives the backoff and eventually gives up.
  failureCount  Int       @default(0)
  lastError     String?
  /// Set once a feed has failed long enough to stop polling it.
  disabledAt    DateTime?

  createdAt DateTime @default(now())

  items         FeedItem[]
  subscriptions FeedSubscription[]

  @@index([disabledAt, lastCheckedAt])
}

/// An item seen in a feed. Doubles as the dedupe set and the delivery backlog.
model FeedItem {
  id       String @id @default(cuid())
  sourceId String
  /// The feed's own id for the item, falling back to the link.
  guid     String

  title       String
  link        String
  author      String?
  summary     String?
  imageUrl    String?
  publishedAt DateTime?
  seenAt      DateTime  @default(now())

  source     FeedSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  deliveries FeedDelivery[]

  @@unique([sourceId, guid])
  @@index([sourceId, seenAt])
}

/// Which items a subscriber has already been sent.
///
/// Separate from FeedItem because two people following the same feed are at
/// different points in it — one on an hourly digest, one reading on demand.
model FeedDelivery {
  id             String   @id @default(cuid())
  subscriptionId String
  itemId         String
  sentAt         DateTime @default(now())

  subscription FeedSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  item         FeedItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, itemId])
  @@index([subscriptionId, sentAt])
}

model GuildConfig {
  id                 String   @id @default(cuid())
  guildId            String   @unique
  modLogChannelId    String? // channel to log moderation actions
  welcomeEnabled     Boolean  @default(false)
  welcomeChannelId   String?
  welcomeMessage     String?
  goodbyeEnabled     Boolean  @default(false)
  goodbyeChannelId   String?
  goodbyeMessage     String?
  musicDefaultVolume Int      @default(50)
  musicIdleMinutes   Int      @default(5)
  musicAutoplay      Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Reminder {
  id        String   @id @default(cuid())
  guildId   String
  channelId String   @default("") // where to deliver; DM fallback when empty
  userId    String
  text      String
  dueAt     DateTime
  createdAt DateTime @default(now())
  completed Boolean  @default(false)

  @@index([completed, dueAt])
}

model ReactionRole {
  id        String   @id @default(cuid())
  guildId   String
  messageId String
  channelId String
  emoji     String
  roleId    String
  createdAt DateTime @default(now())

  @@unique([messageId, emoji])
  @@index([guildId])
}

model Warning {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  moderatorId String
  reason      String
  createdAt   DateTime @default(now())

  @@index([guildId, userId])
}

/// Simple key/value store for runtime settings changed from Discord,
/// so they survive a restart without editing .env.
model BotSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Users and guilds the bot owner has blocked from using the bot.
model Blacklist {
  id        String   @id @default(cuid())
  targetId  String   @unique
  type      String // "user" or "guild"
  reason    String?
  createdAt DateTime @default(now())
}

model User {
  id                  String   @id @default(cuid())
  userId              String   @unique // Discord user ID
  balance             Int      @default(0) // Wallet balance
  bank                Int      @default(0) // Bank balance
  linkedRolesVerified Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model UserEconomy {
  id           String    @id @default(cuid())
  userId       String    @unique // Global per user, not per guild
  coins        Int       @default(0)
  level        Int       @default(1)
  xp           Int       @default(0)
  lastDaily    DateTime?
  lastWork     DateTime?
  lastRob      DateTime?
  totalWagered Int       @default(0) // Total amount wagered
  totalWon     Int       @default(0) // Total amount won
  gamesPlayed  Int       @default(0) // Total games played
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model UserInventory {
  id        String   @id @default(cuid())
  userId    String
  itemId    String // Item identifier (e.g., "bg_sunset", "badge_winner")
  itemType  String // "background", "badge", "color"
  itemName  String
  equipped  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId])
}

/// A saved 1337x search the bot re-runs on a schedule, announcing releases it
/// has not seen before. `seenIds` is a capped, comma-separated list of torrent
/// ids already announced, which is what stops a watch repeating itself.
model TorrentWatch {
  id            String    @id @default(cuid())
  guildId       String
  channelId     String    @default("") // where to post; DM fallback when empty
  userId        String
  query         String
  category      String?
  resolution    String?
  minSeeders    Int       @default(0)
  seenIds       String    @default("")
  active        Boolean   @default(true)
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([active])
  @@index([userId])
}
