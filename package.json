{
  "name": "zenitsubot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "register:commands": "dotenv -e .env -- tsx scripts/register-commands.ts",
    "verify:commands": "dotenv -e .env -- tsx scripts/verify-commands.ts",
    "clear:commands": "dotenv -e .env -- tsx scripts/clear-commands.ts"
  },
  "dependencies": {
    "@discordjs/rest": "^2.3.0",
    "@discordjs/voice": "^0.16.0",
    "@prisma/client": "^5.18.0",
    "axios": "^1.7.5",
    "cors": "^2.8.5",
    "discord-interactions": "^4.3.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "pino": "^9.4.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.18.0",
    "shoukaku": "^4.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/node": "^22.5.4",
    "@types/passport-discord": "^0.1.9",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.8",
    "typescript": "^5.6.2",
    "vitest": "^1.6.0"
  }
}
